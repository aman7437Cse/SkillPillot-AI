# ====================================================================
# SkillPilot AI - Environment Configuration Example
# Copy this file to .env in your server/ and client/ directories or set them up individually
# ====================================================================

# Backend Server Configuration (server/.env)
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=your_jwt_secret_development_fallback_key_32chars

# AI Engine Configuration (Gemini API)
# Get a key from Google AI Studio: https://aistudio.google.com/
# If not provided, SkillPilot AI will seamlessly operate using its rich deterministic AI simulator.
GEMINI_API_KEY=

# Supabase Persistence Configuration
# Get credentials from your Supabase dashboard: https://supabase.com/
# If not provided, SkillPilot AI operates with its high-fidelity in-memory/local mock database.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Frontend Configuration (client/.env)
VITE_API_URL=http://localhost:5001/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
